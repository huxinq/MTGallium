#!/usr/bin/env python3
"""Map declarations in tracked Kotlin, Python and JavaScript source files.

Uses tools/outline's lexical navigation model. Does not resolve references.
An explicit --root must be a Git checkout; untracked files are excluded.
Use --language kotlin (repeatable) to avoid unrelated unsupported JS syntax.
"""
import argparse
import json
from pathlib import Path
import runpy
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--name", help="filter declaration names by substring")
    parser.add_argument("--language", choices=["kotlin", "python", "javascript"], action="append",
                        help="scan only selected languages; repeat to combine (default: all)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    outline = runpy.run_path(str(Path(__file__).with_name("outline")))["outline"]
    try:
        root = args.root.resolve()
        raw = subprocess.check_output(["git", "-C", str(root), "ls-files", "-z"], stderr=subprocess.PIPE)
        paths = sorted(raw.decode("utf-8").rstrip("\0").split("\0")) if raw else []
        rows = []
        language_suffixes = {"kotlin": {".kt", ".kts"}, "python": {".py"},
                             "javascript": {".js", ".mjs", ".cjs"}}
        suffixes = set().union(*(language_suffixes[name] for name in
                                (args.language or language_suffixes)))
        for relative in paths:
            path = root / relative
            if path.suffix not in suffixes:
                continue
            if path.is_symlink() or root not in path.resolve().parents:
                raise ValueError(f"unsafe symlink/path: {relative}")
            try:
                declarations = outline(path)
            except (SyntaxError, ValueError) as error:
                raise ValueError(f"{relative}: {error}") from error
            for row in declarations:
                if args.name is None or args.name in row["name"]:
                    rows.append(dict(file=relative, **row))
    except (OSError, UnicodeError, SyntaxError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(2, f"code-map: {error}\n")
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for row in rows:
            print(f"{row['name']}\t{row['file']}:{row['start']}-{row['end']}\t{row['kind']}")


if __name__ == "__main__":
    main()
