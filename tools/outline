#!/usr/bin/env python3
"""Print declarations with line ranges and first doc line; --map indexes every tracked file.

Python uses its AST. Kotlin and JavaScript use a lexical navigation model, not a
symbol table: strings and comments are masked, declarations must start a line,
and a body ends at its matching brace or, for an expression body, at its line.
"""
import argparse
import ast
from pathlib import Path
import re
import subprocess

SUFFIXES = {".py", ".kt", ".kts", ".js", ".mjs", ".cjs"}
LITERAL = re.compile(r'"""[\s\S]*?"""|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'|`[^`\n]*`'
                     r'|//[^\n]*|/\*[\s\S]*?\*/')
DECLARATION = re.compile(
    r"(?m)^[ \t]*(?:@[\w.]+(?:\([^\n)]*\))?\s+)*(?:(?:public|private|protected|internal|open|abstract|"
    r"final|data|sealed|enum|annotation|inline|inner|value|companion|suspend|override|tailrec|operator|infix|"
    r"external|expect|actual|export|default|async|static|const|lateinit)\s+)*(?P<kind>class|interface|object|typealias|fun|function|val|var|let|const)\s+"
    r"(?:<[^>\n]+>\s*)?(?P<name>`[^`\n]+`|[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)")


def outline(path):
    source = path.read_text(encoding="utf-8")
    if path.suffix == ".py":
        return sorted((dict(kind="class" if isinstance(node, ast.ClassDef) else "fun", name=node.name,
                            start=node.lineno, end=node.end_lineno,
                            doc=(ast.get_docstring(node) or "").partition("\n")[0])
                       for node in ast.walk(ast.parse(source, filename=str(path)))
                       if isinstance(node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef))),
                      key=lambda row: (row["start"], row["name"]))
    code = LITERAL.sub(lambda m: re.sub(r"[^\n]", " ", m.group()), source)
    pairs, stack = {}, []
    for index, char in enumerate(code):
        if char == "{":
            stack.append(index)
        elif char == "}" and stack:
            pairs[stack.pop()] = index
    matches = list(DECLARATION.finditer(code))
    starts = {match.start() for match in matches}
    rows = []
    for match in matches:
        end, depth = code.find("\n", match.end()) % (len(code) + 1), 0
        for offset in range(match.end(), len(code)):
            char = code[offset]
            if offset in starts and depth == 0:
                break
            if char in "([":
                depth += 1
            elif char in ")]":
                depth -= 1
                end = max(end, offset) if depth == 0 else end
            elif depth == 0 and char in "{};=":
                end = pairs.get(offset, end) if char == "{" else end
                break
        before = source[:match.start()].rstrip()
        begin = before.rfind("/**") if before.endswith("*/") else -1
        lines = [line.strip(" *") for line in before[begin + 3:-2].splitlines()] \
            if begin >= 0 and "*/" not in before[begin + 3:-2] else []
        rows.append(dict(kind=match["kind"], name=match["name"], start=code.count("\n", 0, match.start()) + 1,
                         end=code.count("\n", 0, end) + 1, doc=next((line for line in lines if line), "")))
    return rows


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("files", nargs="*", type=Path)
    parser.add_argument("--map", action="store_true", help="index every tracked source file")
    parser.add_argument("--name", help="with --map, keep declarations whose name contains this text")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    files = args.files or []
    if args.map:
        tracked = subprocess.check_output(["git", "-C", str(root), "ls-files"], text=True).splitlines()
        files = [root / name for name in tracked if Path(name).suffix in SUFFIXES]
    for path in files:
        try:
            rows = outline(path)
        except (OSError, UnicodeError, SyntaxError) as error:
            parser.exit(2, f"outline: {path}: {error}\n")
        label = path.relative_to(root) if args.map else path
        for row in rows:
            if args.map and (row["kind"] not in {"class", "interface", "object", "typealias"}
                             or (args.name and args.name not in row["name"])):
                continue
            print(f"{label}:{row['start']}-{row['end']} {row['kind']} {row['name']}"
                  + (f" — {row['doc']}" if row["doc"] else ""))


if __name__ == "__main__":
    main()
